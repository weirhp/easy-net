#include <windows.h>
#include <commctrl.h>

#pragma code_page(65001)

#include "resource.h"

IDD_LAUNCHER DIALOGEX 0, 0, 760, 520
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "Easy-Net Hook"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Easy-Net Hook", IDC_TITLE, 18, 12, 720, 20
    LTEXT           "为常用应用创建可编辑的代理启动入口", IDC_SUBTITLE, 18, 33, 720, 12

    GROUPBOX        "快捷启动入口", -1, 14, 52, 330, 452
    LTEXT           "单击编辑，双击直接启动", -1, 28, 71, 292, 12
    CONTROL         "", IDC_ENTRIES, "SysListView32", WS_TABSTOP | WS_BORDER | LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS, 26, 88, 306, 330
    PUSHBUTTON      "＋ 新建入口", IDC_NEW_ENTRY, 26, 432, 98, 28
    PUSHBUTTON      "删除入口", IDC_REMOVE_ENTRY, 132, 432, 86, 28
    LTEXT           "", IDC_ENTRY_STATE, 26, 469, 292, 22

    GROUPBOX        "入口设置", -1, 354, 52, 392, 452
    LTEXT           "入口名称", -1, 368, 72, 90, 11
    EDITTEXT        IDC_ENTRY_NAME, 368, 85, 364, 22, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "启动场景", -1, 368, 116, 90, 11
    COMBOBOX        IDC_MODE, 368, 129, 364, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "SOCKS5 代理", -1, 368, 160, 100, 11
    EDITTEXT        IDC_PROXY, 368, 173, 364, 22, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "程序路径", -1, 368, 204, 100, 11
    EDITTEXT        IDC_PATH, 368, 217, 290, 22, ES_AUTOHSCROLL | WS_TABSTOP
    PUSHBUTTON      "浏览...", IDC_BROWSE, 666, 216, 66, 24
    LTEXT           "启动参数（可选）", -1, 368, 248, 130, 11
    EDITTEXT        IDC_ARGUMENTS, 368, 261, 364, 22, ES_AUTOHSCROLL | WS_TABSTOP
    CONTROL         "使用独立配置（不复用现有登录）", IDC_ISOLATED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 368, 293, 260, 18
    CONTROL         "接管已经运行的微信（仅新连接生效）", IDC_WECHAT_EXISTING, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 368, 293, 270, 18
    LTEXT           "UDP/QUIC", IDC_UDP_LABEL, 646, 296, 58, 11
    COMBOBOX        IDC_UDP_MODE, 646, 309, 86, 90, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "DNS（可选）", -1, 368, 319, 120, 11
    EDITTEXT        IDC_DNS, 368, 332, 262, 22, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "", IDC_HINT, 368, 364, 364, 47
    CONTROL         "启动成功后关闭本窗口", IDC_CLOSE_AFTER_LAUNCH, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 368, 420, 180, 18
    LTEXT           "正在新建入口", IDC_STATUS, 368, 445, 364, 18
    PUSHBUTTON      "保存入口", IDC_SAVE_ENTRY, 510, 461, 96, 30
    DEFPUSHBUTTON   "保存并启动", IDC_LAUNCH, 614, 461, 118, 30
END
